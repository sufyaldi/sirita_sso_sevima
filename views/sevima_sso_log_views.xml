<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_sevima_sso_log_tree" model="ir.ui.view">
        <field name="name">sevima.sso.log.list</field>
        <field name="model">sevima.sso.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log Autentikasi SSO Sevima" create="false" edit="false" decoration-danger="status == 'failed'" decoration-warning="status == 'error'" decoration-success="status == 'success'">
                <field name="login_date"/>
                <field name="name"/>
                <field name="login_input"/>
                <field name="user_id"/>
                <field name="role_info"/>
                <field name="ip_address"/>
                <field name="latency_ms" string="Latency (ms)"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'error'"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sevima_sso_log_form" model="ir.ui.view">
        <field name="name">sevima.sso.log.form</field>
        <field name="model">sevima.sso.log</field>
        <field name="arch" type="xml">
            <form string="Detail Log Autentikasi SSO Sevima" create="false" edit="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="success,failed,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Sesi">
                            <field name="login_date"/>
                            <field name="login_input"/>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                        </group>
                        <group string="Metrik &amp; Peran Sevima">
                            <field name="role_info"/>
                            <field name="latency_ms"/>
                            <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'error'"/>
                        </group>
                    </group>
                    <group string="Pesan / Status Verifikasi">
                        <field name="message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Payload Respon API Sevima" name="page_raw">
                            <field name="raw_response" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sevima_sso_log_search" model="ir.ui.view">
        <field name="name">sevima.sso.log.search</field>
        <field name="model">sevima.sso.log</field>
        <field name="arch" type="xml">
            <search string="Pencarian Log SSO">
                <field name="name"/>
                <field name="login_input"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="role_info"/>
                <separator/>
                <filter string="Sukses" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Gagal / Ditolak" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Gangguan / Error" name="filter_error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter string="Hari Ini" name="filter_today" domain="[('login_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="Kelompokkan Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                <filter string="Kelompokkan Peran" name="group_by_role" domain="[]" context="{'group_by': 'role_info'}"/>
                <filter string="Kelompokkan Pengguna" name="group_by_user" domain="[]" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_sevima_sso_log" model="ir.actions.act_window">
        <field name="name">Audit Log SSO Sevima</field>
        <field name="res_model">sevima.sso.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sevima_sso_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada catatan log autentikasi SSO Sevima.
            </p>
            <p>
                Seluruh aktivitas login civitas akademika menggunakan akun Sevima Platform (SIAKAD Cloud) akan dicatat secara otomatis di sini untuk audit keamanan.
            </p>
        </field>
    </record>
</odoo>
